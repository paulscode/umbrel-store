#!/usr/bin/env bash

# Patch datum_gateway_config.json with the things only the host knows: the node's
# RPC details, and this app's Umbrel password for the dashboard's admin pages.
#
# Same shape as the official Umbrel Datum app's hook, and the same reason for
# existing. The gateway runs directly against this file rather than through the
# image's entrypoint, so that the dashboard's Config page can write to it and have
# the change survive a restart. Anything the host has to supply therefore has to
# be merged in here, before the container starts.
#
# Everything else in the file is the user's. This only ever sets the four keys
# below, so a setting changed in the dashboard is not undone on the next start.

set -euo pipefail

APP_DATA_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")"
DATUM_CONFIG_FILE="${APP_DATA_DIR}/data/settings/datum_gateway_config.json"
DESIRED_OWNER="1000:1000"

# WRITTEN HERE IF ABSENT, RATHER THAN ASSUMED PRESENT.
#
# The defaults below are shipped as data/settings/datum_gateway_config.json, and
# an install copies them. An UPDATE does not: umbreld copies only
# `docker-compose.yml *.template exports.sh torrc hooks`, so an install that
# updated into the version which first needed this file never received it.
# Docker then created the bind-mount source as an empty root-owned directory and
# the gateway crash-looped on "unable to open /app/conf/datum_gateway_config.json".
#
# Exiting non-zero here did not prevent that, it only hid the reason. So the file
# is created from these defaults when missing, which repairs such an install on
# its next start and costs nothing when the file is already there. The patching
# below then fills in the host-supplied values as usual.
if [ ! -f "${DATUM_CONFIG_FILE}" ]; then
  echo "DATUM configuration file missing; writing defaults."
  mkdir -p "$(dirname "${DATUM_CONFIG_FILE}")"
  cat > "${DATUM_CONFIG_FILE}" <<'DATUMCONF'
{
  "bitcoind": {
    "rpcuser": "auto-configure-on-install",
    "rpcpassword": "auto-configure-on-install",
    "rpcurl": "auto-configure-on-install"
  },
  "api": {
    "listen_port": 7152,
    "modify_conf": true,
    "admin_password": "umbrel"
  },
  "mining": {
    "pool_address": "",
    "coinbase_tag_primary": "DATUM BLAKE2b on Umbrel",
    "coinbase_tag_secondary": "DATUM BLAKE2b on Umbrel",
    "pow_algorithm": "auto"
  },
  "stratum": {
    "listen_port": 23336,
    "vardiff_min": 64
  },
  "logger": {
    "log_level_console": 2
  },
  "datum": {
    "pool_host": "",
    "pooled_mining_only": false
  }
}
DATUMCONF
fi

# The node app exports these. Empty means it is not installed or its exports
# failed, and there is nothing useful to do with a gateway that cannot reach a
# node, so say which one is missing rather than writing an empty credential and
# leaving the gateway to fail with a 401 nobody can trace.
for var in APP_KNOTS_BLAKE2B_RPC_USER APP_KNOTS_BLAKE2B_RPC_PASS \
           APP_KNOTS_BLAKE2B_NODE_IP APP_KNOTS_BLAKE2B_RPC_PORT; do
  if [ -z "${!var:-}" ]; then
    echo "Missing ${var} from the Knots (BLAKE2b) Companion app. Exiting."
    exit 1
  fi
done

echo "Pointing DATUM at the BLAKE2b node."

jq --arg user "$APP_KNOTS_BLAKE2B_RPC_USER" \
   --arg pass "$APP_KNOTS_BLAKE2B_RPC_PASS" \
   --arg url "${APP_KNOTS_BLAKE2B_NODE_IP}:${APP_KNOTS_BLAKE2B_RPC_PORT}" \
   '.bitcoind.rpcuser = $user |
    .bitcoind.rpcpassword = $pass |
    .bitcoind.rpcurl = $url' \
   "$DATUM_CONFIG_FILE" > "${DATUM_CONFIG_FILE}.tmp" && mv "${DATUM_CONFIG_FILE}.tmp" "$DATUM_CONFIG_FILE"

# The dashboard's admin pages are gated on this, and without it the page that
# lists your connected miners returns 401 with no way to authenticate. Set to this
# app's Umbrel password, which the user can read from the app icon's context menu
# under "Show default credentials". The username is `admin`, which DATUM hardcodes.
#
# Only replaced while it is still the seeded placeholder, so a password the user
# has since changed in the dashboard is left alone.
if jq -e '.api.admin_password == "umbrel"' "$DATUM_CONFIG_FILE" > /dev/null; then
  jq --arg password "$APP_PASSWORD" '.api.admin_password = $password' \
     "$DATUM_CONFIG_FILE" > "${DATUM_CONFIG_FILE}.tmp" && mv "${DATUM_CONFIG_FILE}.tmp" "$DATUM_CONFIG_FILE"
fi

# Let the dashboard write this file. Without it the Config page appears to work
# and every save is discarded.
if ! jq -e '.api.modify_conf' "$DATUM_CONFIG_FILE" > /dev/null; then
  jq '.api.modify_conf = true' \
     "$DATUM_CONFIG_FILE" > "${DATUM_CONFIG_FILE}.tmp" && mv "${DATUM_CONFIG_FILE}.tmp" "$DATUM_CONFIG_FILE"
fi

# THE ADDRESS TO POINT A MINER AT, WHICH ONLY THE HOST KNOWS.
#
# The gateway runs in a container on the apps network. From in there it can see
# neither the address this device answers on nor anything about the port published
# in front of it, so its status page could only ever guess from the address you
# happened to open the page with — and most people open Umbrel by name, which is
# exactly the thing mining firmware cannot resolve. This hook runs on the host, so
# it can simply look.
#
# `ip route get` reports the source address of the route to somewhere off the LAN,
# which is this device's primary address. `hostname -I` is not a substitute: it
# lists every interface including each Docker bridge, in no useful order.
#
# Rewritten on every start rather than written once, because it is derived and a
# DHCP lease can move. Left alone when the lookup fails, so a previously good value
# survives a start with no network.
HOST_IP="$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
if [ -n "${HOST_IP}" ]; then
  echo "Telling the gateway to advertise ${HOST_IP} as the address for miners."
  jq --arg host "$HOST_IP" '.stratum.advertised_host = $host' \
     "$DATUM_CONFIG_FILE" > "${DATUM_CONFIG_FILE}.tmp" && mv "${DATUM_CONFIG_FILE}.tmp" "$DATUM_CONFIG_FILE"
else
  echo "Could not determine this device's LAN address; the status page will fall back to the address you open it with."
fi

# A payout address that is not one. Earlier versions of this app asked the node
# for an address on first start; this one leaves it empty and the dashboard asks,
# which is what the official app does. Clear the upstream placeholder if a config
# from that app is ever dropped in here.
if jq -e '.mining.pool_address | select(. == "enter your bitcoin address")' "$DATUM_CONFIG_FILE" > /dev/null; then
  jq '.mining.pool_address = ""' \
     "$DATUM_CONFIG_FILE" > "${DATUM_CONFIG_FILE}.tmp" && mv "${DATUM_CONFIG_FILE}.tmp" "$DATUM_CONFIG_FILE"
fi

# A POOL PUBKEY THAT WOULD KILL THE GATEWAY, DEFUSED BEFORE IT DOES.
#
# The pool's public key is 128 hex characters: an ed25519 key and an x25519 key,
# each 64, concatenated. Paste 127 of them, or a key with a 0x prefix, and
# datum_pubkey_to_struct logs "Pool public key is not the correct length!" and
# main exits FATAL before anything else starts.
#
# That is unrecoverable here in a way it is not on StartOS. There the settings
# live in actions, which run while the service is down. Here the dashboard is
# the only settings form there is, it is served by the process that just died,
# and `restart: on-failure` then crash-loops it. The Config page never loads
# again, so the value that broke it cannot be corrected from the app at all.
#
# So an invalid key is not handed to the gateway. Pooled mining is turned off for
# this start, which lets the gateway run and the dashboard come back, and the
# host is kept under "pool_host(old)", which is DATUM's own convention for a
# remembered host: selecting pooled mining again on the Config page restores it.
# The rejected key is left in place, so it is visible on that page and can be
# corrected rather than silently discarded.
#
# ONLY WHEN THE KEY IS ACTUALLY SET, WHICH IS THE WHOLE POINT.
#
# DATUM compiles in a default pool pubkey and uses it whenever the config names
# none, so host and port alone start perfectly well and are what a pool's own
# instructions usually ask for. Treating an absent key as a bad one would turn
# pooled mining off for exactly the people who followed those instructions. An
# empty string is different from absent and is checked: the config description
# claims empty means auto-fetch, no version of DATUM implements that, and it is
# fatal like any other wrong length.
# SEEDED WITH CONVOY'S KEY, BECAUSE DATUM'S BUILT-IN ONE IS THE OTHER CHAIN'S.
#
# DATUM compiles in a pool pubkey and uses it whenever the config names none.
# That key is Ocean's, and Ocean mines the chain that kept SHA256d, so on this
# chain the built-in default is never the right answer: a gateway given a host
# and a port alone would offer Ocean's key to Convoy and the handshake would
# fail, with nothing on the dashboard to suggest why.
#
# Convoy's key is seeded here so that a host and a port are all this app needs,
# which is what its own instructions ask for. Read from a gateway connected to
# Convoy on 11 September 2026, where the dashboard reported "Connected and
# Ready" against Pool Tag "CONVOY".
#
# Two cases are repaired. Absent, which is every install predating this. And
# DATUM's own key present verbatim, which is what a config carried over from the
# official Datum Gateway app looks like, and what somebody gets if they read the
# key out of DATUM's documentation. Ocean does not serve this chain, so that key
# is never a usable answer here whichever way it arrived.
#
# Anything else is the operator's and is left alone, including a key they pasted
# from Convoy themselves and any key Convoy rotates to later.
CONVOY_POOL_PUBKEY="dbb11fa0c2b5403e4f798fa6071bb97e6079d219598366032fdf2ae01962b13c5e66e2be7d6b008f0b2603f3e6f6fc64768fa786c8129c46d3e30a5867734b62"
DATUM_BUILTIN_POOL_PUBKEY="f21f2f0ef0aa1970468f22bad9bb7f4535146f8e4a8f646bebc93da3d89b1406f40d032f09a417d94dc068055df654937922d2c89522e3e8f6f0e649de473003"

CURRENT_POOL_PUBKEY="$(jq -r '.datum.pool_pubkey // ""' "$DATUM_CONFIG_FILE" | tr 'A-Z' 'a-z')"
if [ -z "${CURRENT_POOL_PUBKEY}" ] || [ "${CURRENT_POOL_PUBKEY}" = "${DATUM_BUILTIN_POOL_PUBKEY}" ]; then
  if [ -n "${CURRENT_POOL_PUBKEY}" ]; then
    echo "The configured pool public key is DATUM's built-in one, which belongs to Ocean on the chain that kept SHA256d."
  fi
  echo "Setting Convoy's pool public key, which is the one this chain needs."
  jq --arg key "$CONVOY_POOL_PUBKEY" '.datum.pool_pubkey = $key' \
     "$DATUM_CONFIG_FILE" > "${DATUM_CONFIG_FILE}.tmp" && mv "${DATUM_CONFIG_FILE}.tmp" "$DATUM_CONFIG_FILE"
fi

POOL_HOST="$(jq -r '.datum.pool_host // ""' "$DATUM_CONFIG_FILE")"
POOL_PUBKEY_SET="$(jq -r '(.datum // {}) | has("pool_pubkey")' "$DATUM_CONFIG_FILE")"
POOL_PUBKEY="$(jq -r '.datum.pool_pubkey // ""' "$DATUM_CONFIG_FILE")"

if [ -n "${POOL_HOST}" ] && [ "${POOL_PUBKEY_SET}" = "true" ] \
   && ! printf '%s' "${POOL_PUBKEY}" | grep -Eq '^[0-9a-fA-F]{128}$'; then
  echo "Pool host is set to '${POOL_HOST}', but the pool public key is not 128 hex characters."
  echo "The gateway exits on that, and its dashboard is the only place to correct it, so pooled mining is off for this start."
  echo "Open the Config tab, set Collaborative reward sharing back to prefer or require, and re-enter the pool's public key."
  jq '.datum["pool_host(old)"] = .datum.pool_host |
      .datum.pool_host = "" |
      .datum.pooled_mining_only = false' \
     "$DATUM_CONFIG_FILE" > "${DATUM_CONFIG_FILE}.tmp" && mv "${DATUM_CONFIG_FILE}.tmp" "$DATUM_CONFIG_FILE"
fi

# The gateway runs as 1000:1000 and has to be able to rewrite this file, which is
# the whole point of modify_conf.
# THE DIRECTORY TOO, NOT JUST THE FILE.
#
# modify_conf is on, and the gateway saves by writing a temp file beside this one
# and renaming it, which needs write permission on the DIRECTORY. Chowning only
# the file leaves the dashboard's Config page reporting "Error writing new config
# file (changes will be lost at restart)" and silently discarding every save.
#
# The directory is usually root-owned precisely when this matters: Docker creates
# a missing bind-mount source as root, which is what happens on an install that
# updated into needing this file and never received it.
chown "${DESIRED_OWNER}" "$(dirname "${DATUM_CONFIG_FILE}")"
chown "${DESIRED_OWNER}" "$DATUM_CONFIG_FILE"

echo "DATUM configuration updated successfully."
