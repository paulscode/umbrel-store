<!doctype html>
<meta charset="utf-8">
<title>Electrs Pruned</title>
<style>
  body { font: 16px/1.6 system-ui, sans-serif; max-width: 42rem; margin: 4rem auto; padding: 0 1.5rem; color: #1a1a1a; }
  h1 { font-size: 1.5rem; margin-bottom: .25rem; }
  p.sub { color: #666; margin-top: 0; }
  code { background: #f2f2f2; padding: .15rem .35rem; border-radius: .2rem; }
  pre { background: #f2f2f2; padding: .75rem 1rem; border-radius: .3rem; overflow-x: auto; }
  h2 { font-size: 1.05rem; margin-top: 2rem; }

  /* The connection string and its copy button share a row, so the button sits
     against the value it copies rather than below it. */
  .copyrow { display: flex; align-items: stretch; gap: .5rem; }
  .copyrow pre { flex: 1; margin: 0; display: flex; align-items: center; }
  .copybtn {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; background: #f2f2f2; border: 0; border-radius: .3rem;
    color: #555; cursor: pointer; font: inherit;
  }
  .copybtn:hover { background: #e6e6e6; color: #1a1a1a; }
  .copybtn:active { background: #dcdcdc; }
  .copybtn svg { width: 1.05rem; height: 1.05rem; }
  .feedback { display: none; align-self: center; color: #2a7d3f; font-size: .875rem; white-space: nowrap; }
  .note { color: #666; font-size: .875rem; }

  .card { border: 1px solid #e0e0e0; border-radius: .5rem; padding: 1rem 1.25rem; margin: 1.5rem 0; }
  .status { font-size: 1.1rem; font-weight: 600; margin: 0 0 .6rem; }
  .bar { height: .5rem; border-radius: .25rem; overflow: hidden; background: #e6e6e6; }
  .bar > i { display: block; height: 100%; width: 0; background: #2a7d3f; transition: width .6s ease; }
  .bar.indeterminate > i { width: 100% !important; opacity: .35; }
  .detail { color: #666; font-size: .9rem; margin: .6rem 0 0; }
  .stale { color: #a06000; font-size: .85rem; margin: .35rem 0 0; }
</style>
<h1>Electrs Pruned</h1>
<p class="sub">An Electrum server indexing your pruned Bitcoin node.</p>

<div class="card">
<p class="status" id="status">Checking the index</p>
<div class="bar indeterminate" id="bar"><i id="fill"></i></div>
<p class="detail" id="detail">Asking the server how far it has got.</p>
<p class="stale" id="stale" hidden></p>
</div>

<h2>Connect a wallet on your network</h2>
<p>Point any Electrum-compatible wallet at your Umbrel, on port <code>50201</code>,
   using plaintext TCP rather than SSL.</p>

<div class="copyrow">
  <pre id="conn">&lt;your-umbrel-address&gt;:50201:t</pre>
  <button id="copybtn" class="copybtn" type="button" title="Copy" aria-label="Copy connection string">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
  </button>
  <span id="copyfeedback" class="feedback">Copied</span>
</div>
<p id="connnote" class="note" style="display:none">
  Substitute the address you use to reach this Umbrel.
</p>

<p>In Sparrow that is Preferences, then Server, then Private Electrum, with
   "Use SSL" off. In Electrum it is the <code>host:50201:t</code> form above.</p>

<h2>Connect another Umbrel app</h2>
<p>Declare a dependency on this app and read the endpoint it exports:</p>
<pre>APP_ELECTRS_PRUNED_SERVER_IP
APP_ELECTRS_PRUNED_SERVER_PORT</pre>

<h2>While it is indexing</h2>
<p>The first sync builds an address index over the whole chain and takes hours.
   Wallets can connect before it finishes, but balances are only correct once it
   catches up.</p>
<p>Blocks your node has pruned are fetched from the peer-to-peer network and
   checked against your node before use, so a wallet asking about very old
   transactions waits for a network round trip. Recent history is unaffected.</p>

<script>
(function () {
  var connEl = document.getElementById('conn');
  var noteEl = document.getElementById('connnote');
  var btnEl = document.getElementById('copybtn');
  var feedbackEl = document.getElementById('copyfeedback');

  // The browser reached this page through the Umbrel it is asking about, so its
  // own address is the one a wallet needs. Whatever form that took is the right
  // answer to show: a .local name, a bare IP and a Tailscale name are all
  // equally usable as an Electrum host, so unlike a server name there is nothing
  // to parse out of it. Filling it in beats asking someone to substitute a
  // placeholder they have to go and look up.
  //
  // The placeholder stays only when the hostname is genuinely unknowable, which
  // is a page opened from a file rather than served. `localhost` is left alone
  // rather than rejected: it is correct from the machine doing the browsing,
  // which is the only place that string is being read.
  var host = String(location.hostname || '');
  if (host) {
    connEl.textContent = host + ':50201:t';
  } else {
    noteEl.style.display = 'block';
  }

  // Umbrel is served over plain http, so this is not a secure context and
  // navigator.clipboard is usually absent. Three paths, most capable first:
  //   1. navigator.clipboard.writeText, for the cases where it is available
  //   2. execCommand('copy') via an offscreen textarea, the legacy path that
  //      does work over http
  //   3. select the string so one Ctrl-C finishes the job, and say so
  // Same ladder as HashGG uses, for the same reason.
  function flash(msg) {
    var original = feedbackEl.textContent;
    if (msg) feedbackEl.textContent = msg;
    feedbackEl.style.display = 'inline-block';
    setTimeout(function () {
      feedbackEl.style.display = 'none';
      if (msg) feedbackEl.textContent = original;
    }, 3000);
  }

  function tryExec(text) {
    try {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      var ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    } catch (e) {
      return false;
    }
  }

  function selectSource() {
    var range = document.createRange();
    range.selectNodeContents(connEl);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }

  btnEl.addEventListener('click', function () {
    var text = connEl.textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        flash();
      }).catch(function () {
        if (tryExec(text)) flash();
        else { selectSource(); flash('Select & Ctrl-C'); }
      });
    } else if (tryExec(text)) {
      flash();
    } else {
      selectSource();
      flash('Select & Ctrl-C');
    }
  });
})();
</script>

<script>
(function () {
  var elStatus = document.getElementById('status');
  var elBar = document.getElementById('bar');
  var elFill = document.getElementById('fill');
  var elDetail = document.getElementById('detail');
  var elStale = document.getElementById('stale');

  function num(n) { return typeof n === 'number' ? n.toLocaleString() : '?'; }

  function paint(state, detail, fraction) {
    elStatus.textContent = state;
    elDetail.textContent = detail;
    if (fraction === null) {
      elBar.classList.add('indeterminate');
      elFill.style.width = '100%';
    } else {
      elBar.classList.remove('indeterminate');
      elFill.style.width = (Math.max(0, Math.min(1, fraction)) * 100) + '%';
    }
  }

  function render(d) {
    var now = Math.floor(Date.now() / 1000);
    // nginx keeps serving the last file the poller wrote, so a number that has
    // stopped moving needs to be distinguishable from an index that has.
    if (d && d.at && now - d.at > 60) {
      elStale.textContent = 'Last updated ' + (now - d.at) + ' seconds ago.';
      elStale.hidden = false;
    } else {
      elStale.hidden = true;
    }

    var indexed = d && typeof d.indexed === 'number' ? d.indexed : null;
    var node = d && d.node && d.node.result ? d.node.result : null;

    if (indexed === null) {
      paint('Starting up',
            'The server is not reporting progress yet. It publishes this once it ' +
            'has opened its database, which takes a moment after a start.', null);
      return;
    }

    // Without the node there is no target, so an honest height beats a made-up
    // percentage. This is the case where the node is down or still starting.
    if (!node || typeof node.blocks !== 'number') {
      paint('Indexing',
            'Indexed to block ' + num(indexed) + '. The percentage needs the ' +
            'node’s height too, and the node is not answering yet.', null);
      return;
    }

    var target = node.blocks;
    var detail = 'Indexed block ' + num(indexed) + ' of ' + num(target) + '.';
    // The node being mid-sync is worth saying, because it means the finish line
    // is still moving and the percentage can go down as well as up.
    if (node.initialblockdownload) {
      detail += ' Your node is still syncing, so this target is still rising.';
    }

    // One block of slack: electrs and the node are polled separately, so a new
    // block can land between the two reads and make a finished index look behind.
    if (indexed >= target - 1) {
      paint('Up to date', detail, 1);
    } else {
      paint('Indexing ' + (target > 0 ? (indexed / target * 100).toFixed(2) : '0.00') + '%',
            detail, target > 0 ? indexed / target : null);
    }
  }

  function tick() {
    fetch('status.json', { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(render)
      .catch(function () {
        paint('Cannot read the status',
              'The page could not fetch status.json from this app.', null);
      });
  }

  tick();
  setInterval(tick, 10000);
})();
</script>
