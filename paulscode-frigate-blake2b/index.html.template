<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Frigate Companion</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 46rem; margin: 2rem auto; padding: 0 1rem; color: #1c1c1c; background: #fafafa; }
  h1 { font-size: 1.4rem; } h2 { font-size: 1.1rem; margin-top: 2rem; }
  .card { background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 1rem 1.2rem; margin: 1rem 0; }
  code { background: #f0f0f0; padding: 0.1rem 0.3rem; border-radius: 4px; }
  .ok { color: #1a7f37; } .bad { color: #b42318; } .wait { color: #9a6700; }
  label { display: block; margin: 0.8rem 0 0.2rem; font-weight: 600; }
  input, select { padding: 0.35rem; font-size: 1rem; }
  .hint { font-size: 0.9rem; color: #555; margin: 0.2rem 0; }
  button { margin-top: 1rem; padding: 0.5rem 1rem; font-size: 1rem; }
</style>
</head>
<body>
<h1>Frigate Companion</h1>
<p>A Silent Payments Electrum server. It follows the Bitcoin node this app is connected to, and passes ordinary wallet requests to its Electrum server.</p>

<div class="card">
  <h2>Connect a wallet</h2>
  <p>Point a Silent Payments wallet (for example Sparrow) at <code id="addr">this Umbrel</code>, port <code id="port"></code>, TCP.</p>
  <p class="hint">On the BLAKE2b chain the wallet must support Electrum protocol 1.8, as the Sparrow BLAKE2b build does.</p>
</div>

<div class="card">
  <h2>Status</h2>
  <p id="state">Loading...</p>
  <p id="start" class="hint"></p>
  <p id="backend" class="hint"></p>
</div>

<div class="card">
  <h2>Settings</h2>
  <form id="form">
    <label for="startHeight">Index start height</label>
    <input id="startHeight" type="number" min="0" step="1">
    <p class="hint">Silent Payments in earlier blocks are not found. The default is Taproot activation (709632). On a pruned node a new index starts at the oldest block the node still holds; a larger prune target reaches further back. Changing this rebuilds the index.</p>

    <label for="cacheSize">ScriptPubKey cache</label>
    <select id="cacheSize"><option>1M</option><option>5M</option><option value="10M">10M (default, about 4 GB of RAM)</option><option>20M</option><option>50M</option></select>

    <label for="computeBackend">Compute backend</label>
    <select id="computeBackend"><option value="AUTO">Auto (prefer GPU)</option><option value="GPU">GPU only</option><option value="CPU">CPU only</option></select>
    <p class="hint">Hardware for historical scans. Only a recent Intel iGPU is supported in this build; otherwise the CPU is used.</p>

    <label for="batchSize">Batch size</label>
    <input id="batchSize" type="number" min="1" step="1">
    <p class="hint">Transactions per GPU dispatch. If scanning stalls on an older GPU, try 10,000 to 50,000.</p>

    <label><input id="rebuild" type="checkbox"> Rebuild the index</label>
    <p class="hint">Delete the Silent Payments index and build it again. Use it after Frigate stopped because the node pruned blocks it still needed, or after connecting a node on another chain.</p>

    <button type="submit">Save and restart Frigate</button>
    <p id="saved" class="hint"></p>
  </form>
</div>

<script>
var loaded = false;
function el(id) { return document.getElementById(id); }
function show(s) {
  el('addr').textContent = location.hostname;
  el('port').textContent = s.electrumPort;
  var st = s.status, state = el('state');
  if (!st) { state.textContent = 'Frigate is starting.'; state.className = 'wait'; }
  else if (st.fatal) { state.textContent = 'Stopped: ' + st.fatal; state.className = 'bad'; }
  else if (st.listening) { state.textContent = 'Ready. Wallets can connect.'; state.className = 'ok'; }
  else if (st.progress) { state.textContent = 'Indexing: ' + st.progress + '. Wallets can connect once it has caught up.'; state.className = 'wait'; }
  else { state.textContent = 'Frigate is starting.'; state.className = 'wait'; }
  el('start').textContent = st && st.start !== null ? 'Silent Payments are indexed from block ' + st.start + '.' : '';
  var b = el('backend');
  if (st && st.backend === 'same') { b.textContent = 'The Electrum server follows the same chain as the node.'; b.className = 'hint ok'; }
  else if (st && st.backend === 'different') { b.textContent = 'The Electrum server follows a different chain from the node, so wallets are refused. Connect both to the same node. ' + st.backendDetail; b.className = 'hint bad'; }
  else { b.textContent = 'The Electrum server is checked once the index has caught up.'; b.className = 'hint'; }
  if (s.rebuildPending) el('saved').textContent = 'Rebuild pending: Frigate restarts in a few seconds.';
  if (!loaded) {
    el('startHeight').value = s.settings.startHeight;
    el('cacheSize').value = s.settings.cacheSize;
    el('computeBackend').value = s.settings.computeBackend;
    el('batchSize').value = s.settings.batchSize;
    loaded = true;
  }
}
function refresh() { fetch('api/state').then(function (r) { return r.json(); }).then(show).catch(function () {}); }
el('form').addEventListener('submit', function (e) {
  e.preventDefault();
  var body = { startHeight: parseInt(el('startHeight').value, 10), cacheSize: el('cacheSize').value,
               computeBackend: el('computeBackend').value, batchSize: parseInt(el('batchSize').value, 10), rebuild: el('rebuild').checked };
  fetch('api/settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
    .then(function (r) { return r.json(); })
    .then(function (j) { el('saved').textContent = j.ok ? 'Saved. Frigate restarts within a few seconds.' : 'Not saved: ' + j.error; el('rebuild').checked = false; refresh(); });
});
refresh(); setInterval(refresh, 10000);
</script>
</body>
</html>
