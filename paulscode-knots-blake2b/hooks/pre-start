#!/usr/bin/env bash

# Adapted from the official Bitcoin Knots app's pre-start hook. Two jobs: fix
# ownership of files an earlier version of this app may have created as root, and
# hold the full start back until Tor has published its hidden services, so the
# connect modal has addresses to show rather than "notyetset.onion".

APP_DATA_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../data")"
DESIRED_OWNER="1000:1000"

set_correct_permissions() {
	local -r path="${1}"

	if [[ -e "${path}" ]]; then
		owner=$(stat -c "%u:%g" "${path}")

		if [[ "${owner}" != "${DESIRED_OWNER}" ]]; then
			chown -R "${DESIRED_OWNER}" "${path}"
			echo "Changed ownership of ${path} to ${DESIRED_OWNER}"
		fi
	fi
}

# The bitcoind data directory is `data`, not `data/bitcoin`. This app has kept its
# chain there since it shipped, and the node app is pointed at it with BITCOIN_DIR
# rather than being asked to move several gigabytes of blocks to match the layout
# the official apps use. See exports.sh.
#
# Every version of this app so far ran bitcoind as uid 1000 already, so this is
# repair rather than migration, and it is cheap enough to do unconditionally.
set_correct_permissions "${APP_DATA_DIR}/bitcoin.conf"
set_correct_permissions "${APP_DATA_DIR}/umbrel-bitcoin.conf"
set_correct_permissions "${APP_DATA_DIR}/bitcoin.conf.save"
set_correct_permissions "${APP_DATA_DIR}/settings.json"

# The app's own state, which is new in this version: the settings the UI writes.
if [[ -d "${APP_DATA_DIR}/app" ]]; then
	chown -R "${DESIRED_OWNER}" "${APP_DATA_DIR}/app"
fi

# ---------------------------------------------------------------------------
# Repair two states that stop bitcoind dead on an upgrade from the pre-UI
# version of this app. Both were found on a live install; neither is theoretical.
#
# 1. A STALE bitcoin.conf.
#
# Before this app ran the forked Umbrel UI, its bitcoind was configured by an
# entrypoint that generated `bitcoin.conf` itself, including `rpcbind=0.0.0.0`.
# The UI backend now owns that file, but it only PREPENDS its `includeconf` line
# and leaves whatever else is there. bitcoind then binds 0.0.0.0 first, which
# already covers every address, and fails the managed `rpcbind=10.21.21.62` and
# `rpcbind=127.0.0.1` that follow:
#
#   Binding RPC on address 10.21.21.62 port 18443 failed (Address already in use)
#   Unable to bind all endpoints for RPC server
#
# bitcoind exits 1, the node process stays up, and the app looks healthy while
# the node is dead. The backend regenerates a correct one-line bitcoin.conf when
# it is missing, so moving the stale file aside is the whole repair.
if [[ -f "${APP_DATA_DIR}/bitcoin.conf" ]] \
   && grep -q "generated by entrypoint" "${APP_DATA_DIR}/bitcoin.conf"; then
	mv "${APP_DATA_DIR}/bitcoin.conf" "${APP_DATA_DIR}/bitcoin.conf.pre-ui-backup"
	echo "App: ${APP_ID} - moved a stale entrypoint-generated bitcoin.conf aside;"
	echo "App: ${APP_ID} - the settings in it are kept at data/bitcoin.conf.pre-ui-backup"
fi

# 2. BLOCK FILTER INDEX ON A PRUNED NODE.
#
# The UI defaults blockfilterindex on, which is right for the official app
# because that one is archival by default. This app prunes by default, and
# bitcoind refuses to start when the index needs blocks that are already gone:
#
#   Index "basic block filter index" needs block data that has been pruned.
#   A fatal internal error occurred ... Failed to start indexes, shutting down.
#
# Turned off only while pruning is on, and only if the user has not already
# turned it off, so an archival install and a deliberate choice are both left
# alone. Someone who wants block filters can set prune to 0 and switch them back
# on in Advanced Settings.
SETTINGS="${APP_DATA_DIR}/app/settings.json"
if [[ -f "${SETTINGS}" ]]; then
	# Heredoc is <<'PYEOF' and the body sits at column 0 on purpose. With <<-
	# bash strips leading tabs from every line, which flattens Python's own
	# indentation and the script dies with an IndentationError that this hook
	# would swallow.
	python3 - "${SETTINGS}" <<'PYEOF' || true
import json, sys

path = sys.argv[1]
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
if not isinstance(data, dict):
    sys.exit(0)

prune = data.get("prune", 0)
if isinstance(prune, bool) or not isinstance(prune, (int, float)) or prune <= 0:
    sys.exit(0)
if not (data.get("blockfilterindex") or data.get("peerblockfilters")):
    sys.exit(0)

data["blockfilterindex"] = False
data["peerblockfilters"] = False
with open(path, "w") as f:
    json.dump(data, f, indent=2)
print("turned blockfilterindex off: it cannot run on a pruned node")
PYEOF
fi

# Delay booting the full app until the RPC and P2P Tor Hidden Services are ready.

HIDDEN_SERVICE_FILE="${TOR_DATA_DIR}/app-${APP_ID}-rpc/hostname"

if [[ -f "${HIDDEN_SERVICE_FILE}" ]]; then
	exit
fi

"${UMBREL_ROOT}/scripts/app" compose "${APP_ID}" up --detach app
"${UMBREL_ROOT}/scripts/app" compose "${APP_ID}" up --detach tor

echo "App: ${APP_ID} - Generating Tor Hidden Service..."

for attempt in $(seq 1 100); do
	if [[ -f "${HIDDEN_SERVICE_FILE}" ]]; then
		echo "App: ${APP_ID} - Hidden service file created successfully!"
		break
	fi
	sleep 0.1
done

if [[ ! -f "${HIDDEN_SERVICE_FILE}" ]]; then
	echo "App: ${APP_ID} - Hidden service file wasn't created"
fi
