#!/usr/bin/env bash

# Adapted from the official Bitcoin Knots app's pre-start hook. Two jobs: fix
# ownership of files an earlier version of this app may have created as root, and
# hold the full start back until Tor has published its hidden services, so the
# connect modal has addresses to show rather than "notyetset.onion".

APP_DATA_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../data")"
DESIRED_OWNER="1000:1000"

set_correct_permissions() {
	local -r path="${1}"

	if [[ -e "${path}" ]]; then
		owner=$(stat -c "%u:%g" "${path}")

		if [[ "${owner}" != "${DESIRED_OWNER}" ]]; then
			chown -R "${DESIRED_OWNER}" "${path}"
			echo "Changed ownership of ${path} to ${DESIRED_OWNER}"
		fi
	fi
}

# The bitcoind data directory is `data`, not `data/bitcoin`. This app has kept its
# chain there since it shipped, and the node app is pointed at it with BITCOIN_DIR
# rather than being asked to move several gigabytes of blocks to match the layout
# the official apps use. See exports.sh.
#
# Every version of this app so far ran bitcoind as uid 1000 already, so this is
# repair rather than migration, and it is cheap enough to do unconditionally.
set_correct_permissions "${APP_DATA_DIR}/bitcoin.conf"
set_correct_permissions "${APP_DATA_DIR}/umbrel-bitcoin.conf"
set_correct_permissions "${APP_DATA_DIR}/bitcoin.conf.save"
set_correct_permissions "${APP_DATA_DIR}/settings.json"

# The app's own state, which is new in this version: the settings the UI writes.
if [[ -d "${APP_DATA_DIR}/app" ]]; then
	chown -R "${DESIRED_OWNER}" "${APP_DATA_DIR}/app"
fi

# Delay booting the full app until the RPC and P2P Tor Hidden Services are ready.

HIDDEN_SERVICE_FILE="${TOR_DATA_DIR}/app-${APP_ID}-rpc/hostname"

if [[ -f "${HIDDEN_SERVICE_FILE}" ]]; then
	exit
fi

"${UMBREL_ROOT}/scripts/app" compose "${APP_ID}" up --detach app
"${UMBREL_ROOT}/scripts/app" compose "${APP_ID}" up --detach tor

echo "App: ${APP_ID} - Generating Tor Hidden Service..."

for attempt in $(seq 1 100); do
	if [[ -f "${HIDDEN_SERVICE_FILE}" ]]; then
		echo "App: ${APP_ID} - Hidden service file created successfully!"
		break
	fi
	sleep 0.1
done

if [[ ! -f "${HIDDEN_SERVICE_FILE}" ]]; then
	echo "App: ${APP_ID} - Hidden service file wasn't created"
fi
